rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function itemOwner(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId)).data.userId;
    }

    function item(itemId) {
      return get(/databases/$(database)/documents/items/$(itemId));
    }

    function user(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function claimAfter(itemId, claimId) {
      return getAfter(/databases/$(database)/documents/items/$(itemId)/claims/$(claimId));
    }

    function claim(itemId, claimId) {
      return get(/databases/$(database)/documents/items/$(itemId)/claims/$(claimId));
    }

    function conversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /chatKeys/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(["encryptionPublicKey"])
        && request.resource.data.encryptionPublicKey is map;
      allow delete: if false;
    }

    match /items/{itemId} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId);

      match /claims/{claimId} {
        allow read: if signedIn() && (request.auth.uid == itemOwner(itemId) || request.auth.uid == resource.data.claimantId);
	        allow create: if signedIn()
	          && claimId == request.auth.uid
	          && request.auth.uid == request.resource.data.claimantId
          && request.auth.uid != itemOwner(itemId)
          && request.resource.data.itemId == itemId
          && request.resource.data.itemOwnerId == itemOwner(itemId)
          && request.resource.data.status == "sent"
          && request.resource.data.contact == user(request.auth.uid).data.telegramContact;
        allow update: if signedIn()
          && request.auth.uid == itemOwner(itemId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "updatedBy"])
          && request.resource.data.status in ["sent", "reviewing", "accepted"]
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == itemOwner(itemId);
      }
    }

    match /alerts/{alertId} {
      allow read: if signedIn() && request.auth.uid == resource.data.recipientId;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "type",
          "recipientId",
          "createdBy",
          "itemId",
          "itemTitle",
          "itemType",
          "claimId",
          "claimantId",
          "claimantName",
          "message",
          "status",
          "createdAt"
        ])
        && request.resource.data.type == "claim"
        && request.resource.data.status == "unread"
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.claimantId == request.auth.uid
        && request.resource.data.recipientId == itemOwner(request.resource.data.itemId)
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.itemTitle == item(request.resource.data.itemId).data.title
        && request.resource.data.itemType == item(request.resource.data.itemId).data.type
        && request.resource.data.message is string
        && request.resource.data.claimantName is string
        && claimAfter(request.resource.data.itemId, request.resource.data.claimId).data.itemId == request.resource.data.itemId
        && claimAfter(request.resource.data.itemId, request.resource.data.claimId).data.itemOwnerId == request.resource.data.recipientId
        && claimAfter(request.resource.data.itemId, request.resource.data.claimId).data.claimantId == request.auth.uid
        && claimAfter(request.resource.data.itemId, request.resource.data.claimId).data.status == "sent";
	      allow update: if signedIn()
	        && request.auth.uid == resource.data.recipientId
	        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "dismissedAt"])
	        && request.resource.data.status == "dismissed"
	        && request.resource.data.dismissedAt == request.time;
	      allow delete: if false;
	    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["itemId", "claimId", "participantIds", "createdAt"])
        && request.resource.data.createdAt == request.time
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds[0] == claim(request.resource.data.itemId, request.resource.data.claimId).data.itemOwnerId
        && request.resource.data.participantIds[1] == claim(request.resource.data.itemId, request.resource.data.claimId).data.claimantId
        && request.auth.uid in request.resource.data.participantIds
        && claim(request.resource.data.itemId, request.resource.data.claimId).data.status == "accepted";
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in conversation(conversationId).data.participantIds;
        allow create: if signedIn()
          && request.auth.uid in conversation(conversationId).data.participantIds
          && request.resource.data.keys().hasOnly(["ciphertext", "iv", "senderId", "createdAt"])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() > 0
          && request.resource.data.iv is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

    }
  }
}
