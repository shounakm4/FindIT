{
  "name": "findit",
  "version": "0.1.0",
  "private": true,
  "description": "FindIT mobile-first lost-and-found prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test \"shared/*.test.js\" \"client/src/**/*.test.js\"",
    "preview": "vite preview --host 127.0.0.1 --config client/vite.config.js",
    "firebase:login": "firebase login",
    "preserve:hosting": "npm run build",
    "serve:hosting": "firebase emulators:start --only hosting",
    "predeploy:hosting": "npm run build",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "firebase": "^12.14.0",
    "lucide-react": "^1.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "firebase-tools": "^15.19.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@6.2.3": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.2"
    }
  }
}
