{
  "name": "findit",
  "version": "0.1.0",
  "private": true,
  "description": "NUS FindIT Milestone 1 prototype with React frontend and Node backend.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 127.0.0.1 --config client/vite.config.js",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --host 127.0.0.1 --config client/vite.config.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "firebase": "^12.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12"
  }
}
