{
  "name": "findit",
  "version": "0.1.0",
  "private": true,
  "description": "FindIT mobile-first lost-and-found prototype.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 127.0.0.1 --config client/vite.config.js",
    "start": "node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --host 127.0.0.1 --config client/vite.config.js",
    "firebase:login": "firebase login",
    "preserve:hosting": "npm run build",
    "serve:hosting": "firebase emulators:start --only hosting",
    "predeploy:hosting": "npm run build",
    "deploy:hosting": "firebase deploy --only hosting"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "firebase": "^12.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "firebase-tools": "^15.19.0"
  }
}
